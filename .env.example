# Supabase (service role for admin user provisioning)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Polar — checkout verification for POST /api/auth/register
POLAR_SECRET_KEY=polar_pat_...
# POLAR_ACCESS_TOKEN=  # alias supported
# POLAR_SKIP_VERIFY=1  # local dev only — skips paid checkout validation

# Notion CRM (B2B contact / lead sync)
# NOTION_SECRET_KEY=secret_...
# NOTION_DATABASE_ID=your-notion-database-id
